# LingoFetch Environment Configuration

# Server Configuration
PORT=8080
ENVIRONMENT=development

# GCP Configuration (for production)
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=your_gcp_credentials_path
FIRESTORE_DATABASE_ID=(default)

# AI Provider Selection
# Options: gemini, llama
AI_PROVIDER=llama

# API Keys (for local development)
# In production, these will be fetched from GCP Secret Manager
GEMINI_API_KEY=your_gemini_api_key_here
LLAMA_API_KEY=your_openrouter_api_key_here # Now uses OpenRouter for free V3 model

# Notion Integration (Legacy/Global)
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Notion OAuth
NOTION_OAUTH_CLIENT_ID=your_notion_client_id
NOTION_OAUTH_CLIENT_SECRET=your_notion_client_secret
NOTION_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/notion/callback

# Security
ENCRYPTION_KEY=your_32_byte_hex_encryption_key
